<?xml version="1.0" encoding="utf-8" ?>
<log4net>

  <root>
    <!--
    <appender-ref ref="ConsoleAppender" />
    -->
    <!-- Default to main log -->
    <level value="INFO" />
    <appender-ref ref="RollingLogFileAppender" />
  </root>

  <!-- Exchange log -->
  <logger name="Ex" additivity="false">
    <level value="INFO" />
    <appender-ref ref="RollingLogFileAppenderExchange" />
  </logger>

  <!-- OCS log -->
  <logger name="OCS" additivity="false">
    <level value="INFO" />
    <appender-ref ref="RollingLogFileAppenderOCS" />
  </logger>

  <!-- Synchronisation log -->
  <logger name="Sync" additivity="false">
    <level value="INFO" />
    <appender-ref ref="RollingLogFileAppenderSynchronisation" />
  </logger>

  <!-- ######################################################
       CONSOLE APPENDER 
       ###################################################### -->
  <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
    <!--<param name="Threshold" value="INFO" />-->
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %logger [%property{NDC}] - %message%newline" />
    </layout>
  </appender>

  <!-- ######################################################
       MAIN LOG
       ROLLING LOG FILE APPENDER - appends to log files and rolls
       them over by date or when they reach a certain size
       ###################################################### -->
  <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
    <!-- Store log files in "Log" folder off app folder -->
    <file value="\Users\\Public\\RDT\\Log\\RDT_Main_" />
    <appendToFile value="true" />
    <!-- roll files on date change, and/or when they reach size limit -->
    <rollingStyle value="Composite" />
    <!-- Use the date as part of the filename-->
    <param name="StaticLogFileName" value="false" />
    <datePattern value="yyyyMMdd.lo\g" />
    <maxSizeRollBackups value="40" />
    <!-- Roll file when it reaches this size -->
    <maximumFileSize value="50MB" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %c [%x] %message%newline" />
    </layout>
  </appender>

  <!-- ######################################################
       EXCHANGE LOG
       ROLLING LOG FILE APPENDER - appends to log files and rolls
       them over by date or when they reach a certain size
       ###################################################### -->
  <appender name="RollingLogFileAppenderExchange" type="log4net.Appender.RollingFileAppender">
    <!-- Store log files in "Log" folder off app folder -->
    <file value="\Users\\Public\\RDT\\Log\\RDT_Exchange_" />
    <appendToFile value="true" />
    <!-- roll files on date change, and/or when they reach size limit -->
    <rollingStyle value="Composite" />
    <!-- Use the date as part of the filename-->
    <param name="StaticLogFileName" value="false" />
    <datePattern value="yyyyMMdd.lo\g" />
    <maxSizeRollBackups value="40" />
    <!-- Roll file when it reaches this size -->
    <maximumFileSize value="50MB" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %c [%x] %message%newline" />
    </layout>
  </appender>

  <!-- ######################################################
       OCS LOG
       ROLLING LOG FILE APPENDER - appends to log files and rolls
       them over by date or when they reach a certain size
       ###################################################### -->
  <appender name="RollingLogFileAppenderOCS" type="log4net.Appender.RollingFileAppender">
    <!-- Store log files in "Log" folder off app folder -->
    <file value="\Users\\Public\\RDT\\Log\\RDT_OCS_" />
    <appendToFile value="true" />
    <!-- roll files on date change, and/or when they reach size limit -->
    <rollingStyle value="Composite" />
    <!-- Use the date as part of the filename-->
    <param name="StaticLogFileName" value="false" />
    <datePattern value="yyyyMMdd.lo\g" />
    <maxSizeRollBackups value="40" />
    <!-- Roll file when it reaches this size -->
    <maximumFileSize value="50MB" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date [%thread] %-5level %c [%x] %message%newline" />
    </layout>
  </appender>

  <!-- ######################################################
       SYNCHRONISATION LOG
       ROLLING LOG FILE APPENDER - appends to log files and rolls
       them over by date or when they reach a certain size
       ###################################################### -->
  <appender name="RollingLogFileAppenderSynchronisation" type="log4net.Appender.RollingFileAppender">
    <!-- Store log files in "Log" folder off app folder -->
    <file value="\Users\\Public\\RDT\\Log\\RDT_Synchronisation_" />
    <appendToFile value="true" />
    <!-- roll files on date change, and/or when they reach size limit -->
    <rollingStyle value="Composite" />
    <!-- Use the date as part of the filename-->
    <param name="StaticLogFileName" value="false" />
    <datePattern value="yyyyMMdd.lo\g" />
    <maxSizeRollBackups value="40" />
    <!-- Roll file when it reaches this size -->
    <maximumFileSize value="50MB" />
    <layout type="log4net.Layout.PatternLayout">
      <!--- SyncRole is included here to make obvious the role of the machine -->
      <conversionPattern value="%date [%thread] [%property{SyncRole}] %-5level %c [%x] %message%newline" />
    </layout>
  </appender>
</log4net>
